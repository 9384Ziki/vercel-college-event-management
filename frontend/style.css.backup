* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f6f8fc;
  color: #172033;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.navbar {
  height: 72px;
  padding: 0 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  border-bottom: 1px solid #e7eaf0;
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.brand-icon {
  width: 40px;
  height: 40px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: #4f46e5;
  color: white;
  font-weight: 800;
  font-size: 13px;
}

.brand strong {
  display: block;
  font-size: 16px;
}

.brand span {
  display: block;
  color: #8a93a5;
  font-size: 11px;
  margin-top: 2px;
}

nav {
  display: flex;
  gap: 30px;
}

nav a {
  color: #667085;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
}

nav a:hover {
  color: #4f46e5;
}

.nav-user {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 13px;
  color: #667085;
}

.logout-btn {
  border: 0;
  background: #fff1f2;
  color: #be123c;
  padding: 8px 13px;
  border-radius: 8px;
  font-weight: 600;
}

main {
  min-height: calc(100vh - 150px);
}

.hero {
  margin: 38px auto 0;
  width: 88%;
  max-width: 1250px;
  min-height: 360px;
  border-radius: 26px;
  padding: 55px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  background: linear-gradient(120deg, #1e1b4b, #312e81 55%, #4f46e5);
  color: white;
  overflow: hidden;
  position: relative;
}

.hero:after {
  content: "";
  position: absolute;
  width: 330px;
  height: 330px;
  right: -100px;
  top: -100px;
  border-radius: 50%;
  border: 60px solid rgba(255,255,255,.07);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 650px;
}

.badge,
.section-label {
  font-size: 11px;
  letter-spacing: 1.4px;
  font-weight: 800;
  color: #818cf8;
}

.hero .badge {
  color: #c7d2fe;
}

.hero h1 {
  font-size: clamp(38px, 5vw, 65px);
  line-height: 1.02;
  margin: 17px 0;
  letter-spacing: -2px;
}

.hero h1 span {
  color: #a5b4fc;
}

.hero p {
  color: #d5d8ee;
  line-height: 1.7;
  max-width: 550px;
  font-size: 16px;
}

.hero-btn {
  display: inline-block;
  margin-top: 18px;
  padding: 13px 20px;
  border-radius: 10px;
  background: white;
  color: #312e81;
  text-decoration: none;
  font-size: 14px;
  font-weight: 800;
}

.hero-card {
  position: relative;
  z-index: 2;
  width: 280px;
  padding: 25px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 18px;
  background: rgba(255,255,255,.09);
  backdrop-filter: blur(10px);
}

.hero-card-icon {
  font-size: 30px;
}

.hero-card h3 {
  margin: 18px 0 8px;
}

.hero-card p {
  font-size: 13px;
}

.hero-stats {
  display: flex;
  gap: 35px;
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,.15);
}

.hero-stats strong,
.hero-stats span {
  display: block;
}

.hero-stats strong {
  font-size: 22px;
}

.hero-stats span {
  font-size: 11px;
  color: #c7d2fe;
}

.section {
  width: 88%;
  max-width: 1250px;
  margin: 75px auto;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 25px;
}

.section-heading h2 {
  margin: 7px 0;
  font-size: 30px;
  letter-spacing: -.7px;
}

.section-heading p {
  margin: 0;
  color: #7b8495;
  font-size: 14px;
}

.refresh-btn {
  background: white;
  border: 1px solid #dfe3eb;
  color: #475467;
  border-radius: 9px;
  padding: 10px 15px;
  font-weight: 700;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 22px;
}

.search-box {
  flex: 1;
  max-width: 430px;
  height: 46px;
  display: flex;
  align-items: center;
  gap: 9px;
  background: white;
  border: 1px solid #e1e5ec;
  border-radius: 10px;
  padding: 0 14px;
}

.search-box span {
  font-size: 23px;
  color: #98a2b3;
}

.search-box input {
  width: 100%;
  border: 0;
  outline: 0;
  color: #172033;
}

.status {
  color: #7b8495;
  font-size: 13px;
}

.event-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.event-card {
  background: white;
  border: 1px solid #e5e8ee;
  border-radius: 16px;
  padding: 25px;
  transition: transform .2s, box-shadow .2s;
}

.event-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 30px rgba(31, 41, 55, .08);
}

.event-top {
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

.event-number {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: #eef2ff;
  color: #4f46e5;
  font-weight: 800;
}

.event-card h3 {
  margin: 18px 0 8px;
  font-size: 20px;
}

.event-card-description {
  color: #697386;
  font-size: 14px;
  line-height: 1.6;
  min-height: 45px;
}

.event-details {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 20px 0;
}

.event-detail {
  background: #f7f8fa;
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 12px;
  color: #596273;
}

.event-register {
  width: 100%;
  border: 0;
  border-radius: 9px;
  padding: 12px;
  background: #4f46e5;
  color: white;
  font-weight: 800;
}

.event-register:hover {
  background: #4338ca;
}

.event-register.registered {
  background: #ecfdf3;
  color: #027a48;
  cursor: default;
}

.event-register.login-required {
  background: #eef2ff;
  color: #4338ca;
}

.my-events-section {
  padding-bottom: 20px;
}

.my-event {
  background: white;
  border: 1px solid #e5e8ee;
  border-radius: 12px;
  padding: 17px;
  margin-bottom: 10px;
}

.my-event strong {
  display: block;
  margin-bottom: 6px;
}

.my-event span {
  color: #697386;
  font-size: 13px;
}

.my-events-empty {
  background: white;
  border: 1px dashed #d8dde7;
  border-radius: 15px;
  padding: 45px;
  text-align: center;
  color: #7b8495;
}

.empty-icon {
  font-size: 34px;
}

.my-events-empty h3 {
  color: #344054;
  margin-bottom: 5px;
}

.account-section {
  width: 88%;
  max-width: 1250px;
  margin: 80px auto;
}

.account-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  background: white;
  border: 1px solid #e5e8ee;
  border-radius: 20px;
  padding: 45px;
}

.account-info h2 {
  font-size: 30px;
  margin: 10px 0;
}

.account-info p {
  color: #697386;
  line-height: 1.7;
  max-width: 450px;
}

.account-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.account-form input {
  border: 1px solid #dfe3eb;
  border-radius: 9px;
  padding: 13px 14px;
  outline: none;
}

.account-form input:focus {
  border-color: #6366f1;
}

.form-buttons {
  display: flex;
  gap: 10px;
  margin-top: 5px;
}

.primary-btn,
.secondary-btn {
  flex: 1;
  border-radius: 9px;
  padding: 12px;
  font-weight: 800;
}

.primary-btn {
  border: 0;
  background: #4f46e5;
  color: white;
}

.secondary-btn {
  background: white;
  border: 1px solid #dfe3eb;
  color: #344054;
}

.auth-message {
  margin-top: 20px;
  font-size: 13px;
  color: #4f46e5;
}

footer {
  min-height: 90px;
  padding: 25px 6%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #111827;
  color: #d1d5db;
  font-size: 12px;
}

footer strong,
footer span {
  display: block;
}

footer strong {
  color: white;
  margin-bottom: 4px;
}

footer span {
  color: #8d96a5;
}

.toast {
  position: fixed;
  right: 25px;
  bottom: 25px;
  padding: 13px 18px;
  border-radius: 9px;
  background: #172033;
  color: white;
  font-size: 13px;
  opacity: 0;
  transform: translateY(15px);
  pointer-events: none;
  transition: .25s;
  z-index: 50;
}

.toast.show {
  opacity: 1;
  transform: translateY(0);
}

.loading {
  padding: 45px;
  text-align: center;
  color: #7b8495;
}

@media (max-width: 850px) {
  nav {
    display: none;
  }

  .hero {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-card {
    width: 100%;
  }

  .event-grid,
  .account-card {
    grid-template-columns: 1fr;
  }

  .account-card {
    gap: 30px;
  }
}

@media (max-width: 600px) {
  .navbar {
    padding: 0 5%;
  }

  .nav-user span {
    display: none;
  }

  .hero,
  .section,
  .account-section {
    width: 92%;
  }

  .hero {
    padding: 38px 25px;
  }

  .hero h1 {
    font-size: 42px;
  }

  .section {
    margin: 55px auto;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .search-box {
    max-width: none;
  }

  .account-card {
    padding: 28px 22px;
  }

  footer {
    flex-direction: column;
    gap: 15px;
    align-items: flex-start;
  }
}
